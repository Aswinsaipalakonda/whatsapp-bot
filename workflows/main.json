        600
      ],
      "parameters": {
        "jsCode": "const razorpayResponse = $input.first().json;\nconst extractData = $('Code Extract Gemini Reply').item.json;\nconst from = extractData.from;\n\nconst paymentLink = razorpayResponse.short_url || razorpayResponse.id || 'Payment link generation failed';\n\nconst message = `✅ *CIBIL Check Details Received!*\n\nTo get your CIBIL Score, please complete the payment of *₹499*:\n\n💳 *Payment Link:*\n${paymentLink}\n\n⏰ Link valid for 24 hours.\n\nOnce payment is confirmed, your CIBIL score report will be sent here within a few minutes. 🎯`;\n\nreturn [{ json: { from, replyText: message, paymentLinkId: razorpayResponse.id } }];"
      }
