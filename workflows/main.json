      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst promptData = $('Code Build Gemini Prompt').item.json;\nconst from = promptData.from;\nconst route = promptData.route;\nconst userRow = promptData.userRow || {};\n\nlet replyText = '';\ntry {\n  replyText = response.candidates[0].content.parts[0].text || '';\n} catch(e) {\n  replyText = 'Our team will contact you shortly. 🙏';\n}\n\n// Detect action flags\nconst isEligible = replyText.includes('##ELIGIBLE##');\nconst isNotEligible = replyText.includes('##NOT_ELIGIBLE##');\nconst sendPayment = replyText.includes('##SEND_PAYMENT##');\n\n// Extract data update flags\nconst updates = {};\nconst flagPatterns = [\n  { key: 'Name',           flag: /##UPDATE_NAME:([^#]+)##/ },\n  { key: 'Age',            flag: /##UPDATE_AGE:([^#]+)##/ },\n  { key: 'Employment',     flag: /##UPDATE_EMPLOYMENT:([^#]+)##/ },\n  { key: 'Income',         flag: /##UPDATE_INCOME:([^#]+)##/ },\n  { key: 'Existing EMIs',  flag: /##UPDATE_EMIS:([^#]+)##/ },\n  { key: 'Loan Amount',    flag: /##UPDATE_LOANAMT:([^#]+)##/ },\n  { key: 'PAN',            flag: /##UPDATE_PAN:([^#]+)##/ },\n  { key: 'DOB',            flag: /##UPDATE_DOB:([^#]+)##/ },\n  { key: 'Mobile',         flag: /##UPDATE_MOBILE:([^#]+)##/ },\n];\n\nfor (const { key, flag } of flagPatterns) {\n  const match = replyText.match(flag);\n  if (match) updates[key] = match[1].trim();\n}\n\n// Determine new stage\nlet newStage = promptData.stage;\nif (isEligible || isNotEligible) newStage = 'COMPLETED';\nelse if (sendPayment) newStage = 'AWAITING_PAYMENT';\nelse if (route === 'START_LOAN' || route === 'LOAN_FLOW') newStage = 'COLLECT_LOAN';\nelse if (route === 'START_CIBIL' || route === 'CIBIL_FLOW') newStage = 'COLLECT_CIBIL';\n\n// Clean all flags from reply\nlet cleanReply = replyText;\nconst allFlags = /##[A-Z_]+(?::[^#]+)?##/g;\ncleanReply = cleanReply.replace(allFlags, '').trim();\n\nreturn [{\n  json: {\n    from,\n    replyText: cleanReply,\n    isEligible,\n    isNotEligible,\n    sendPayment,\n    newStage,\n    updates,\n    userRow\n  }\n}];"
      }
    },
