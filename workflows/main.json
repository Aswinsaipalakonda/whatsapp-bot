    {
      "id": "n16",
      "name": "Code Build Gemini Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        700
      ],
      "parameters": {
        "jsCode": "const routeData = $input.first().json;\nconst from = routeData.from;\nconst text = routeData.text;\nconst stage = routeData.stage || 'NEW';\nconst route = routeData.route;\nconst userRow = routeData.userRow || {};\n\n// Build conversation context from existing user data\nconst existingData = [];\nif (userRow.Name) existingData.push(`Name: ${userRow.Name}`);\nif (userRow.Age) existingData.push(`Age: ${userRow.Age}`);\nif (userRow.Employment) existingData.push(`Employment: ${userRow.Employment}`);\nif (userRow.Income) existingData.push(`Income: ${userRow.Income}`);\nif (userRow['Existing EMIs']) existingData.push(`Existing EMIs: ${userRow['Existing EMIs']}`);\nif (userRow['Loan Amount']) existingData.push(`Loan Amount Requested: ${userRow['Loan Amount']}`);\nif (userRow.PAN) existingData.push(`PAN: ${userRow.PAN}`);\nif (userRow.DOB) existingData.push(`DOB: ${userRow.DOB}`);\n\nlet flowInstruction = '';\n\nif (route === 'START_LOAN' || stage === 'COLLECT_LOAN') {\n  flowInstruction = `\nUSER WANTS PERSONAL LOAN. Current stage: ${stage}.\nAlready collected: ${existingData.join(', ') || 'nothing yet'}.\n\nCollect these ONE BY ONE in order (skip already collected):\n1. Full Name\n2. Age  \n3. Employment Type (Salaried / Self-Employed / Business Owner)\n4. Monthly Income (net take-home)\n5. Existing monthly EMI payments (if none, ask them to say 0)\n6. Loan Amount Required\n\nAfter collecting ALL 6 details, calculate eligibility:\nELIGIBLE if: Age 21-60 AND income >= 15000 AND total EMIs (existing + estimated new EMI) <= 50% of income\nNOT ELIGIBLE if any condition fails.\n\nWhen giving verdict:\n- If ELIGIBLE: end your message with exactly ##ELIGIBLE##\n- If NOT ELIGIBLE: end your message with exactly ##NOT_ELIGIBLE##\n`;\n} else if (route === 'START_CIBIL' || stage === 'COLLECT_CIBIL') {\n  flowInstruction = `\nUSER WANTS CIBIL SCORE CHECK. Current stage: ${stage}.\nAlready collected: ${existingData.join(', ') || 'nothing yet'}.\n\nCollect these ONE BY ONE in order (skip already collected):\n1. Full Name\n2. PAN Card Number (format: ABCDE1234F)\n3. Date of Birth (DD/MM/YYYY)\n4. Mobile Number linked to PAN\n\nAfter collecting ALL 4 details, end your message with exactly ##SEND_PAYMENT##\n`;\n} else {\n  flowInstruction = `\nAnswer the user's query about personal loans or CIBIL scores only.\nIf they ask about other loans (home, car, business, education), reply:\n\"Our team will contact you shortly for this service. 🙏\"\nIf you cannot answer, reply:\n\"Our team will contact you shortly. 🙏\"\n`;\n}\n\nconst systemPrompt = `You are a professional WhatsApp chatbot for Nidha Easy Loans India.\nYou ONLY handle Personal Loans and CIBIL Score checks.\n\nSTRICT RULES:\n- Keep replies SHORT (max 80 words) — this is WhatsApp\n- Ask only ONE question at a time\n- Be warm, friendly, professional\n- Use simple English\n- Use emojis sparingly\n\n${flowInstruction}\n\nIMPORTANT FLAGS (add at end of message when condition met, never explain them):\n##ELIGIBLE## — user qualifies for personal loan\n##NOT_ELIGIBLE## — user does not qualify\n##SEND_PAYMENT## — all CIBIL details collected\n##UPDATE_NAME:[value]## — when you collect name, add this flag\n##UPDATE_AGE:[value]## — when you collect age\n##UPDATE_EMPLOYMENT:[value]## — when you collect employment type\n##UPDATE_INCOME:[value]## — when you collect income\n##UPDATE_EMIS:[value]## — when you collect existing EMIs\n##UPDATE_LOANAMT:[value]## — when you collect loan amount\n##UPDATE_PAN:[value]## — when you collect PAN\n##UPDATE_DOB:[value]## — when you collect DOB\n##UPDATE_MOBILE:[value]## — when you collect mobile\n\nCurrent user data already in system:\n${existingData.join('\\n') || 'No data yet'}`;\n\nreturn [{\n  json: {\n    from,\n    route,\n    stage,\n    systemPrompt,\n    userMessage: text,\n    userRow\n  }\n}];"
      }
    },
    {
      "id": "n17",
      "name": "HTTP Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2160,
        700
