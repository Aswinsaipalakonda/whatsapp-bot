        "body": "={\n  \"system_instruction\": {\n    \"parts\": [{ \"text\": \"{{ $json.systemPrompt.replace(/\\n/g, '\\\\n') }}\" }]\n  },\n  \"contents\": [{\n    \"parts\": [{ \"text\": \"{{ $json.userMessage }}\" }]\n  }],\n  \"generationConfig\": {\n    \"maxOutputTokens\": 400,\n    \"temperature\": 0.7\n  }\n}",
