    {
      "id": "n10",
      "name": "Code Determine Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        460
      ],
      "parameters": {
        "jsCode": "const parsed = $('Code Parse Message').item.json;\nconst sheetRows = $input.all();\n\nconst from = parsed.from;\nconst text = parsed.text;\nconst isGreeting = parsed.isGreeting;\nconst msgType = parsed.msgType;\n\n// Get user row from sheet (first match or null)\nconst userRow = sheetRows.find(r => r.json && r.json.Phone === from);\nconst stage = userRow?.json?.Stage || 'NEW';\nconst rowIndex = userRow?.json?.row_number || null;\n\nlet route = 'AI_REPLY';\n\nif (isGreeting || stage === 'NEW' || text.toLowerCase() === 'menu') {\n  route = 'GREETING';\n} else if (text === 'loan_assistance' || text.includes('Loan Assistance') || text.toLowerCase().includes('personal loan')) {\n  route = 'START_LOAN';\n} else if (text === 'cibil_services' || text.includes('CIBIL Services') || text.toLowerCase().includes('cibil')) {\n  route = 'START_CIBIL';\n} else if (text.toLowerCase().includes('home loan') || text.toLowerCase().includes('car loan') || text.toLowerCase().includes('business loan') || text.toLowerCase().includes('education loan')) {\n  route = 'OTHER_SERVICES';\n} else if (stage === 'COLLECT_LOAN') {\n  route = 'LOAN_FLOW';\n} else if (stage === 'COLLECT_CIBIL') {\n  route = 'CIBIL_FLOW';\n} else if (stage === 'AWAITING_PAYMENT') {\n  route = 'PAYMENT_PENDING';\n}\n\nreturn [{\n  json: {\n    from, text, stage, route, rowIndex,\n    userRow: userRow?.json || null,\n    isNewUser: !userRow\n  }\n}];"
      }
    },
